# Recruitment Management & Analytics System

# Virtual Environments
.venv/
venv/
env/
ENV/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pycache

# Environment & Secrets
.env
.env.*
*.env
secrets.yaml
secrets.json

# Database Files
*.db
*.sqlite
*.sqlite3

# Generated Data Directories
data/raw/*
data/processed/*
data/exports/*

!data/raw/.gitkeep
!data/processed/.gitkeep
!data/exports/.gitkeep
!data/ground_truth/.gitkeep

# Generated / Temporary Files
*.log
*.tmp
*.bak
*.swp
*.csv
*.xlsx
*.parquet
*.json.gz

# Keep Ground Truth Reports in GitHub
!data/ground_truth/*.csv

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# IDE / Editor
.vscode/
.idea/
*.code-workspace
*.suo
*.user

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# Build & Distribution
dist/
build/
*.egg-info/
*.egg